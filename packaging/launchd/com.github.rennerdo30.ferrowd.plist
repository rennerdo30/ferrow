<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.github.rennerdo30.ferrowd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/ferrow/ferrowd</string>
		<string>--service-endpoint</string>
		<string>--index</string>
		<string>/private/var/lib/ferrow/index.bin</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>WorkingDirectory</key>
	<string>/private/var/lib/ferrow</string>
	<key>StandardOutPath</key>
	<string>/var/log/ferrowd.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/ferrowd.log</string>
</dict>
</plist>
